# Supabase → Project Settings → API (or Connect → API keys).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service_role key (or the newer "secret" key). Keep it server-side: never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the app, and the password you type once to approve the ChatGPT plugin.
APP_PASSWORD=

# Any long random string. Signs the plugin's access tokens (change it to sign everything out)
# and works as a bearer token for the REST API.
API_TOKEN=
