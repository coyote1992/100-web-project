# Database. Local file by default; use a Turso URL + token when deployed (e.g. on Vercel).
DATABASE_URL=file:./data/hundred.db
# On Vercel, the Turso integration sets TURSO_DATABASE_URL / TURSO_AUTH_TOKEN instead; both are read.
# DATABASE_AUTH_TOKEN=

# Optional: password-protect the whole app (browser sign-in, any username).
# APP_PASSWORD=

# Email webhook (POST /api/inbound). Any long random string.
# INBOUND_TOKEN=
# Your outreach mailbox; mail *from* this address is logged as outgoing.
# OUTREACH_ADDRESS=
