# Supabase (or any Postgres): Project settings → Database → Connection string (the pooler one).
# Without it the app uses a local database in ./data/pglite (or temporary storage on Vercel).
DATABASE_URL=

# Lets ChatGPT call /api/v1. Any long random string. Without it the API is off.
API_TOKEN=

# Optional: password-protect the app itself (browser sign-in, any username).
# APP_PASSWORD=
