# Supabase (or any Postgres): Project settings → Database → Connection string (the pooler one).
# Without it the app uses a local database in ./data/pglite (or temporary storage on Vercel).
DATABASE_URL=

# Password for the app, and the password you type once to approve the ChatGPT plugin.
APP_PASSWORD=

# Any long random string. Signs the plugin's access tokens (change it to sign everything out)
# and works as a bearer token for the REST API.
API_TOKEN=
